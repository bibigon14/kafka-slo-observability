# yamllint config for kafka-slo-observability
# Relaxed line-length (k8s manifests often have long image/path strings).
# document-start disabled because multi-doc YAML files use --- separators
# between docs, which yamllint flags under the default "present: false" rule.
extends: default

rules:
  line-length:
    max: 160
    level: warning
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ['true', 'false', 'on', 'off']
  document-start: disable
  indentation:
    spaces: 2
    indent-sequences: true
